<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img"
    tools:context=".HomeFragment">

    <Button
        android:id="@+id/BtnSelfRev"
        android:layout_width="168dp"
        android:layout_height="106dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Self-Revision"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/BtnAssessments"
        app:layout_constraintStart_toStartOf="@+id/BtnAssessments" />

    <Button
        android:id="@+id/BtnStudyPlanner"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Study-Planner"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/BtnSelfRev"
        app:layout_constraintEnd_toEndOf="@+id/BtnAssessments"
        app:layout_constraintTop_toTopOf="@+id/BtnSelfRev" />

    <Button
        android:id="@+id/BtnFeedback"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Feedback"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/BtnReference"
        app:layout_constraintEnd_toEndOf="@+id/BtnAssessments"
        app:layout_constraintTop_toTopOf="@+id/BtnReference" />

    <Button
        android:id="@+id/BtnReference"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/darkpurple"
        android:text="References"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/BtnAssessments"
        app:layout_constraintTop_toBottomOf="@+id/BtnAssessments" />

    <Button
        android:id="@+id/BtnAssessments"
        android:layout_width="361dp"
        android:layout_height="110dp"
        android:layout_marginTop="364dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Assessments"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>