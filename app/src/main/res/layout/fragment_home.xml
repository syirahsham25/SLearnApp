<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img"
    tools:context=".HomeFragment">

    <Button
        android:id="@+id/BtnSelfRev"
        android:layout_width="168dp"
        android:layout_height="106dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="252dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Self-Revision"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/BtnStudyPlanner"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:layout_marginTop="252dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Study-Planner"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/BtnFeedback"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:layout_marginTop="520dp"
        android:backgroundTint="@color/darkpurple"
        android:text="Feedback"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.917"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/BtnReference"
        android:layout_width="168dp"
        android:layout_height="104dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="520dp"
        android:backgroundTint="@color/darkpurple"
        android:text="References"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/BtnAssessments"
        android:layout_width="361dp"
        android:layout_height="110dp"
        android:layout_marginTop="25dp"
        android:backgroundTint="@color/darkpurple"
        android:text="FlashCards"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/BtnSelfRev" />

</androidx.constraintlayout.widget.ConstraintLayout>
