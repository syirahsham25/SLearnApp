<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_10"
    tools:context=".FeedbackActivity">

    <!-- Header Image -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="409dp"
        android:layout_height="139dp"
        android:alpha="0.3"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="55dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/baseline_arrow_left_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ScrollView for Courses -->

    <!-- Add Course Button -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        tools:layout_editor_absoluteX="-1dp">

        <LinearLayout
            android:id="@+id/courses_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp">

            <!-- Course buttons will be added here programmatically -->
            <Button
                android:id="@+id/btnAssignmentFeedbacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/darkpurple"
                android:padding="16dp"
                android:text="My Assignment Feedbacks"
                android:textSize="18sp"
                app:cornerRadius="24dp" />

            <Button
                android:id="@+id/btnAppFeedbacks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/darkpurple"
                android:padding="16dp"
                android:text="My Assignment Feedbacks"
                android:textSize="18sp"
                app:cornerRadius="24dp" />

<!--            <Button-->
<!--                android:id="@+id/btnAppFeedback"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
